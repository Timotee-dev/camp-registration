# Copy to .env for local development. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL empty locally to use SQLite. In production it is required (Neon Postgres URL).
DATABASE_URL=
SITE_NAME=Nexform
TIME_ZONE=Africa/Lagos

# Optional: enables "Forgot password" emails. The site works fully without it.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nexform <you@example.com>
