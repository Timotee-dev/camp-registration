# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@host:5432/dbname   # leave unset to use SQLite

SITE_NAME=Camp Meeting Registration
ORGANISER_NAME=Camp Meeting Committee

# --- Email (leave EMAIL_HOST empty to print emails to the console) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Camp Meeting <you@gmail.com>

# --- SMS: "console" (dev) or "termii" ---
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=CampMeet
TERMII_CHANNEL=generic
